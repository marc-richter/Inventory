# Kopiere diese Datei zu ".env" und passe die Werte an, bevor du "docker compose up -d --build" ausfuehrst.

# Geheimer Schluessel fuer Anmelde-Tokens - unbedingt aendern!
SECRET_KEY=bitte-hier-einen-zufaelligen-langen-text-eintragen

# Erster Admin-Zugang, der beim allerersten Start automatisch angelegt wird
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin1234

# Wie lange eine Anmeldung gueltig bleibt (in Minuten)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Port, unter dem die Weboberflaeche im lokalen Netz erreichbar ist
WEB_PORT=8080

# Port fuer HTTPS-Zugriff. Wird fuer den Kamera-/Barcode-Scan auf dem Handy
# benoetigt (Browser erlauben Kamerazugriff nur ueber HTTPS oder localhost).
# Beim ersten Start wird automatisch ein selbstsigniertes Zertifikat unter
# ./certs erzeugt - die Zertifikatswarnung im Browser muss beim ersten
# Aufruf pro Geraet einmalig bestaetigt werden.
WEB_TLS_PORT=8443

# Host-Verzeichnis fuer Backups (kann z.B. auf ein NAS oder eine externe Platte zeigen)
BACKUP_HOST_PATH=./backups

# Host-Verzeichnis fuer das HTTPS-Zertifikat (Standard: ./certs)
CERTS_HOST_PATH=./certs

# --- Optionale Personalisierung (wird sonst nach der Installation in der App
# abgefragt) ---
# Organisationsname, der im Anmeldebildschirm und in der Kopfzeile erscheint.
DEFAULT_ORG_NAME=
# Pfad INNERHALB des Containers zu einem Logo (i.d.R. unter /app/initial, das per
# INITIAL_ASSETS_HOST_PATH gemountet wird). Die Verwaltungs-Apps setzen dies bei
# der Erstinstallation automatisch, wenn ein Logo gewaehlt wurde.
DEFAULT_LOGO_FILE=
# Host-Verzeichnis, das schreibgeschuetzt nach /app/initial gemountet wird
# (enthaelt z.B. das bei der Erstinstallation gewaehlte Logo).
INITIAL_ASSETS_HOST_PATH=./config
